{
  "name": "xiaocai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "小采 · 采购新人的 AI 师姐 —— macOS 桌面工作台（SQLite 本地库）+ 网页版",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "guard": "node scripts/privacy-guard.mjs",
    "test": "vitest run",
    "deploy:pages": "npm run build && node scripts/deploy-pages.mjs",
    "desktop": "node scripts/desktop-dev.mjs",
    "build:electron": "tsc --noEmit && ELECTRON=1 vite build",
    "dist:mac": "npm run build:electron && electron-builder --mac",
    "smoke:desktop": "ELECTRON=1 vite build && node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.10",
    "dompurify": "^3.2.4",
    "mammoth": "^1.12.2",
    "marked": "^15.0.7",
    "papaparse": "^5.5.2",
    "pdfjs-dist": "^4.10.38",
    "preact": "^10.29.8",
    "typebox": "1.3.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@types/dompurify": "^3.0.5",
    "@types/papaparse": "^5.3.15",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "ai.helport.xiaocai",
    "productName": "小采",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "asar": true,
    "afterPack": "scripts/adhoc-sign.cjs"
  }
}