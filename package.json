    "papaparse": "^5.5.2",
    "preact": "^10.29.8",
    "typebox": "1.3.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@types/dompurify": "^3.0.5",
    "@types/papaparse": "^5.3.15",
    "typescript": "^5.7.3",
